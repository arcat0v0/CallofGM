{
  "name": "@cogm/server",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "bun run scripts/check-boundaries.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/platform/db/migrate-cli.ts",
    "setup:admin": "bun run scripts/setup-admin.ts",
    "db:check": "drizzle-kit check",
    "test": "bun test"
  },
  "dependencies": {
    "@cogm/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz",
    "zod": "^4.4.3",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
